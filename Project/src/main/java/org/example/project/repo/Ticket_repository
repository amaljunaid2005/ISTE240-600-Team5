package com.moviereview.repository;

import com.moviereview.model.Ticket;
import com.moviereview.model.UserProfile;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;

import java.util.List;

public interface TicketRepository extends JpaRepository<Ticket, Long> {

    List<Ticket> findByUser(UserProfile user);

    @Query("SELECT t FROM Ticket t WHERE LOWER(t.movie.title) LIKE LOWER(CONCAT('%', :title, '%'))")
    List<Ticket> findByMovieTitleContaining(@Param("title") String title);
}
