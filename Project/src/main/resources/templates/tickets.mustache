<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tickets</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
    <div class="nav-content">
        <!-- Clicking the logo returns home -->
        <a href="/" class="nav-logo">ReelTalk</a>

        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/movies">Movies</a>
            <a href="/reviews">Reviews</a>
            <a href="/users">Users</a>
            <a href="/tickets">Tickets</a>
        </div>
    </div>
</nav>

<div class="header-container">
    <h2>Tickets</h2>
    <div class="subtitle">Movie Showings & Tickets</div>
</div>

<div class="content-card table-container">
    <table>
        <tr>
            <th>Ticket ID</th>
            <th>User</th>
            <th>Movie</th>
            <th>Show Time</th>
        </tr>
        {{#tickets}}
            <tr>
                <td>{{id}}</td>
                <td>{{user.username}}</td>
                <td>{{movie.movieName}}</td>
                <td>{{showTime}}</td>
            </tr>
        {{/tickets}}

    </table>
</div>

<a href="/tickets/add" class="btn-pill" style="margin-top: 2rem;">Add New Ticket</a>

</body>
</html>
