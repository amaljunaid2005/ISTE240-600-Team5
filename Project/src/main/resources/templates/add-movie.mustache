<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Movie</title>
    <!-- Link to the external CSS file -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<nav class="navbar">
    <div class="nav-content">
        <!-- Clicking the logo returns home -->
        <a href="/" class="nav-logo">ReelTalk</a>

        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/movies">Movies</a>
            <a href="/reviews">Reviews</a>
            <a href="/users">Users</a>
            <a href="/tickets">Tickets</a>
        </div>
    </div>
</nav>
<div class="header-container">
    <h2>Add a Movie</h2>
    <div class="subtitle">Add a movie to our list</div>
</div>
<div class="content-card">
    <form method="post">
        <div class="field">
            <label>Movie Name</label>
            <input type="text" name="movieName" placeholder="Movie Name">
        </div>
        <div class="field">
            <label>Release Year</label>
            <input type="number" name="releaseYear" placeholder="Release Year">
        </div>
        <div class="field">
            <label>Director</label>
            <input type="text" name="director" placeholder="Director">
        </div>
        <div class="field">
            <label>IMDB Rating (/10)</label>
            <input type="number" step="any" name="rating" placeholder="Rating">
        </div>
        <div class="field">
            <label>Lead Actor</label>
            <input type="text" name="leadActor" placeholder="Lead Actor">
        </div>
        <div class="field">
            <label>Genre</label>
            <input type="text" name="genre" placeholder="Genre">
        </div>
        <div class="field">
            <label>Description</label>
            <input type="text" name="description" placeholder="Description">
        </div>
        <button class="btn-pill" type="submit" style="width: 100%;">Submit Movie</button>
    </form>
</div>
<a href="/movies" class="btn-pill btn-secondary">Back to Movies</a>
</body>
</html>