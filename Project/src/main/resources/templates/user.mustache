<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>User</title>
</head>
<body>
<h2>User Table</h2>

<table border="1">
    <tr>
        <th>User ID</th>
        <th>Username</th>
        <th>Email</th>
        <th>Age</th>
        <th>Password</th>
        <th>Bio</th>
    </tr>
    {{#user}}
        <tr>
            <td>{{User ID}}</td>
            <td>{{Username}}</td>
            <td>{{Email}}</td>
            <td>{{Age}}</td>
            <td>{{Password}}</td>
            <td>{{Bio}}</td>

        </tr>
    {{/user}}

</table>

<a href="user/add">Add another user.</a>

</body>
</html>
