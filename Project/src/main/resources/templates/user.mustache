<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>User</title>
</head>
<body>
<h2>User Table</h2>

<table border="1">
    <tr>
        <th>User ID</th>
        <th>Username</th>
        <th>Email</th>
        <th>Age</th>
        <th>Bio</th>
    </tr>
    {{#users}}
        <tr>
            <td>{{userId}}</td>
            <td>{{username}}</td>
            <td>{{email}}</td>
            <td>{{age}}</td>
            <td>{{bio}}</td>

        </tr>
    {{/users}}

</table>

<a href="users/add">Add another user.</a>

</body>
</html>
