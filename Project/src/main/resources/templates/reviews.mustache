<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reviews</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
    <div class="nav-content">
        <!-- Clicking the logo returns home -->
        <a href="/" class="nav-logo">ReelTalk</a>

        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/movies">Movies</a>
            <a href="/reviews">Reviews</a>
            <a href="/users">Users</a>
            <a href="/tickets">Tickets</a>
        </div>
    </div>
</nav>

<div class="header-container">
    <h2>User Reviews</h2>
    <div class="subtitle">Movie Reviews & Ratings</div>
</div>

<div class="content-card table-container">
    <table>
        <thead>
        <tr>
            <th>Date</th>
            <th>User</th>
            <th>Movie</th>
            <th>Rating</th>
            <th>Review</th>
        </tr>
        </thead>
        <tbody>
        {{#reviewList}}
            <tr>
                <td>{{reviewDate}}</td>
                <td style="color: white; font-weight: 600;">{{userProfile.username}}</td>
                <td style="color: white; font-weight: 600;">{{movie.movieName}}</td>
                <td><span class="rating-badge">{{rating}}/10</span></td>
                <td>{{reviewText}}</td>
            </tr>
        {{/reviewList}}
        </tbody>
    </table>
</div>

<a href="/reviews/add" class="btn-pill" style="margin-top: 2rem;">Add New Review</a>

</body>
</html>